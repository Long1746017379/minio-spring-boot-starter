{
  "properties": [
    {
      "name": "minio.enabled",
      "type": "java.lang.Boolean",
      "description": "Whether to enable MinIO auto-configuration",
      "defaultValue": true
    },
    {
      "name": "minio.endpoint",
      "type": "java.lang.String",
      "description": "MinIO server endpoint URL",
      "defaultValue": "http://localhost:9000"
    },
    {
      "name": "minio.access-key",
      "type": "java.lang.String",
      "description": "MinIO access key"
    },
    {
      "name": "minio.secret-key",
      "type": "java.lang.String",
      "description": "MinIO secret key"
    },
    {
      "name": "minio.bucket",
      "type": "java.lang.String",
      "description": "Default bucket name",
      "defaultValue": "default"
    },
    {
      "name": "minio.secure",
      "type": "java.lang.Boolean",
      "description": "Whether to use SSL",
      "defaultValue": false
    },
    {
      "name": "minio.connect-timeout",
      "type": "java.lang.Integer",
      "description": "Connect timeout in milliseconds",
      "defaultValue": 10000
    },
    {
      "name": "minio.read-timeout",
      "type": "java.lang.Integer",
      "description": "Read timeout in milliseconds",
      "defaultValue": 30000
    },
    {
      "name": "minio.write-timeout",
      "type": "java.lang.Integer",
      "description": "Write timeout in milliseconds",
      "defaultValue": 30000
    }
  ]
}